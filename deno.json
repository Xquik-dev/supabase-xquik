{
  "nodeModulesDir": "auto",
  "workspace": ["./supabase/functions/xquik-webhook"],
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check && deno task type-coverage",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-net tests/*_test.ts",
    "test:stack": "deno test --allow-all tests/stack/",
    "type-coverage": "git ls-files --cached --others --exclude-standard -- '*.ts' | xargs deno run --allow-read --allow-run --allow-env scripts/type_coverage.ts",
    "generate": "deno run --allow-read=openapi.json,supabase/migrations --allow-write=supabase/migrations scripts/generate.ts",
    "types": "node_modules/.bin/supabase gen types typescript --local --schema public > supabase/functions/_shared/database.types.ts && deno fmt supabase/functions/_shared/database.types.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "@types/pg": "npm:@types/pg@8",
    "fast-check": "npm:fast-check@4",
    "pg": "npm:pg@8",
    "typescript": "npm:typescript@6.0.3",
    "x-twitter-scraper": "npm:x-twitter-scraper@0.18.0",
    "x-twitter-scraper/": "npm:/x-twitter-scraper@0.18.0/",
    "zod": "npm:zod@4"
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["./types/globals.d.ts"]
  },
  "fmt": {
    "lineWidth": 120,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "jsr", "workspace", "fresh", "react", "jsx"],
      "include": [
        "ban-untagged-todo",
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-boolean-literal-for-arguments",
        "no-eval",
        "no-external-import",
        "no-implicit-declare-namespace-export",
        "no-inferrable-types",
        "no-node-globals",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-process-global",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename",
        "prefer-ascii",
        "single-var-declarator",
        "triple-slash-reference"
      ]
    },
    "plugins": ["./lint/strict.ts"]
  }
}
