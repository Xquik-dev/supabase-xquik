#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik Contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

target="$1"
link="$2"

if [[ -e "${link}" || -L "${link}" ]]; then
  owner=""
  [[ ! -L "${link}" ]] || owner="$(stat -c %u -- "${link}")"
  [[ "${owner}" == "${EUID}" ]] || {
    echo "own-link: ${link} exists and is not a symbolic link that this user owns, so another user could control what runs. Remove it, then rerun." >&2
    exit 1
  }
fi
ln -sfn -- "${target}" "${link}"
points="$(readlink -- "${link}")"
[[ "${points}" == "${target}" ]] || {
  echo "own-link: ${link} does not point to ${target} after the link was made." >&2
  exit 1
}
