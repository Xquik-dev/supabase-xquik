#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik Contributors
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

script_directory="$(dirname "$0")"
root="$(cd "${script_directory}/.." && pwd -P)"
runner="$(git -C "${root}" config --get checklocal.runner || true)"
if [[ -n "${runner}" && "${CHECK_LOCAL_HERE:-}" != 1 ]]; then
  exec "${runner}" "${root}" "$@"
fi

cd "${root}"

repository="Xquik-dev/supabase-xquik"
status_context="xquik-local-checks"
reuse_version="6.2.0"

post_commit_status=true
for argument in "$@"; do
  case "${argument}" in
    --no-status) post_commit_status=false ;;
    *)
      echo "check-local: unknown option ${argument}. Use --no-status or no option." >&2
      exit 2
      ;;
  esac
done

status_commit=""
head_commit="$(git rev-parse HEAD)"
tree_changes="$(git status --porcelain)"
if ! ${post_commit_status}; then
  echo "==> Commit status not posted because --no-status was passed."
elif ! command -v gh >/dev/null; then
  echo "==> Commit status not posted because the GitHub CLI is not installed."
elif [[ -n "${tree_changes}" ]]; then
  echo "==> Commit status not posted because the tree has uncommitted changes."
elif ! gh api --silent "repos/${repository}/commits/${head_commit}" >/dev/null 2>&1; then
  echo "==> Commit status not posted because GitHub does not have HEAD, or gh is signed out. Push first."
else
  status_commit="${head_commit}"
fi

post_status() {
  local state="$1" description="${2:0:139}"
  gh api --silent "repos/${repository}/statuses/${status_commit}" \
    -f state="${state}" -f context="${status_context}" -f description="${description}" >/dev/null 2>&1 ||
    echo "check-local: could not post the ${state} ${status_context} status. Run gh auth status." >&2
}

workspace="$(mktemp -d "${TMPDIR:-/tmp}/supabase-xquik-check-local.XXXXXX")"
current_check="Setup"
passed=()
summary=""

on_exit() {
  local status=$?
  if [[ -n "${status_commit}" ]]; then
    if ((status == 0)) && [[ -n "${summary}" ]]; then
      post_status success "Passed ${summary}"
    else
      post_status failure "Failed at ${current_check}."
    fi
  fi
  rm -rf -- "${workspace:?}"
}
trap on_exit EXIT

if [[ -n "${status_commit}" ]]; then
  echo "==> Posting a pending ${status_context} status to ${status_commit:0:12}."
  post_status pending "Running the checks in bin/check-local."
fi

run_check() {
  local label="$1" name="$2" next_step="$3"
  shift 3
  current_check="${name}"
  echo "==> ${name}"
  "$@" || {
    local status=$?
    echo "check-local: ${name} failed. ${next_step}" >&2
    exit "${status}"
  }
  [[ -z "${label}" ]] || passed+=("${label}")
}

run_check "" "Install the packages that bun.lock pins" \
  "Install Bun and check network access, or update bun.lock, then rerun." \
  bun install --frozen-lockfile
deno=node_modules/.bin/deno

no_banned_patterns() {
  git grep -nIP --untracked -f lint/banned-patterns.txt
  (($? == 1))
}

no_config_exclusions() {
  local found
  found="$(jq -r 'paths | select(.[-1] == "exclude" or .[-1] == "include" or .[-1] == "ignore")
    | select(. != ["lint", "rules", "include"]) | map(tostring) | join(".")' deno.json)" || return
  [[ -z "${found}" ]] || {
    printf 'deno.json narrows a check with these keys.\n%s\n' "${found}" >&2
    return 1
  }
}

type_coverage() {
  local listing files=()
  listing="$(git ls-files --cached --others --exclude-standard -- '*.ts')" || return
  mapfile -t files <<<"${listing}"
  "${deno}" run --allow-read --allow-run --allow-env scripts/type_coverage.ts "${files[@]}"
}

full_coverage() {
  local measured
  measured="$(git ls-files --cached --others --exclude-standard -- '*.ts' ':(exclude)*_test.ts' ':(exclude)*.d.ts')" ||
    return
  awk -v root="${PWD}/" -v measured="${measured}" '
    BEGIN { split(measured, names, "\n"); for (i in names) wanted[names[i]] = 1 }
    /^SF:/ {
      file = substr($0, 4)
      if (index(file, root) == 1) file = substr(file, length(root) + 1)
      counted = file in wanted
      if (counted) seen[file] = 1
      else { print "The report measured " file ", which is not a tracked TypeScript source file."; stray = 1 }
    }
    !counted { next }
    /^DA:/ { split(substr($0, 4), part, ","); if (part[2] == 0) print file ":" part[1] " has a line that no test runs." }
    /^BRDA:/ { split(substr($0, 6), part, ","); if (part[4] == "-" || part[4] == 0) print file ":" part[1] " has a branch that no test takes." }
    /^FNDA:/ { split(substr($0, 6), part, ","); if (part[1] == 0) print file " has the function " part[2] ", which no test calls." }
    /^LF:/ { lines += substr($0, 4) }
    /^LH:/ { lines_hit += substr($0, 4) }
    /^BRF:/ { branches += substr($0, 5) }
    /^BRH:/ { branches_hit += substr($0, 5) }
    /^FNF:/ { functions += substr($0, 5) }
    /^FNH:/ { functions_hit += substr($0, 5) }
    END {
      for (file in wanted) if (!(file in seen)) { print file " is missing from the coverage report."; missing = 1 }
      printf "Tests cover %d of %d lines, %d of %d branches and %d of %d functions.\n",
        lines_hit, lines, branches_hit, branches, functions_hit, functions
      exit missing || stray || lines_hit != lines || branches_hit != branches || functions_hit != functions
    }' "$1"
}

run_tests() {
  local coverage="${workspace}/coverage" totals
  NO_COLOR=1 DENO_COVERAGE_DIR="${coverage}" "${deno}" test --allow-read --allow-write --allow-run --allow-env --allow-net \
    --coverage="${coverage}" tests/*_test.ts 2>&1 | tee "${workspace}/tests.log" || return
  totals="$(grep -E '^ok \| ' "${workspace}/tests.log" | tail -n 1)" || return
  [[ "${totals}" != *" ignored"* ]] || {
    printf 'The run ignored a test or a step, so it did not run every test.\n%s\n' "${totals}" >&2
    return 1
  }
  "${deno}" coverage --lcov --output="${workspace}/lcov.info" "${coverage}" > /dev/null &&
    full_coverage "${workspace}/lcov.info"
}

lint_shell() {
  local listing files=()
  listing="$({
    git ls-files --cached --others --exclude-standard -- '*.sh' '*.bash' &&
      { git grep -lIE --untracked '^#!.*sh( |$)' -- ':(exclude,glob)**/?*.*' || (($? == 1)); }
  } | sort -u)" || return
  mapfile -t files <<<"${listing}"
  shellcheck --norc --check-sourced --enable=all --extended-analysis=true --severity=style "${files[@]}"
}

audit_dependencies() {
  "${deno}" audit && bun audit
}

run_codeql() {
  local source="${workspace}/codeql-source" database="${workspace}/codeql-database"
  local results="${workspace}/codeql-results.sarif" diagnostic="js/diagnostics/extraction-errors"
  local unread tracked extracted skipped count
  mkdir "${source}" &&
    git ls-files -z --cached --others --exclude-standard | tar --null -T - -cf - | tar -xf - -C "${source}" &&
    codeql database create "${database}" --language=javascript --build-mode=none --source-root="${source}" \
      --threads=0 --quiet >/dev/null &&
    codeql database analyze "${database}" codeql/javascript-queries:codeql-suites/javascript-security-extended.qls \
      --download --format=sarif-latest --output="${results}" --threads=0 --quiet >/dev/null || return
  jq -e --arg id "${diagnostic}" 'any(.runs[].tool["driver"].notifications[]?; .id == $id)' "${results}" >/dev/null || {
    echo "The CodeQL suite did not run ${diagnostic}, so the scan cannot show that it read every file." >&2
    return 1
  }
  unread="$(jq -r --arg id "${diagnostic}" '
    [.runs[].invocations[]?.toolExecutionNotifications[]? | select(.descriptor.id == $id)
      | .locations[0].physicalLocation | "\(.artifactLocation.uri) at line \(.region.startLine)"]
    | unique | join(" and ")' "${results}")" || return
  [[ -z "${unread}" ]] || {
    echo "CodeQL could not parse ${unread}, so the scan is incomplete." >&2
    return 1
  }
  tracked="$(git ls-files --cached --others --exclude-standard -- '*.ts')" || return
  extracted="$(jq -r '.runs[].invocations[]?.toolExecutionNotifications[]?
    | select(.descriptor.id == "js/diagnostics/successfully-extracted-files")
    | .locations[0].physicalLocation.artifactLocation.uri' "${results}")" || return
  skipped="$(awk -v extracted="${extracted}" '
    BEGIN { count = split(extracted, names, "\n"); for (i = 1; i <= count; i++) read[names[i]] = 1 }
    !($0 in read)' <<<"${tracked}")" || return
  [[ -z "${skipped}" ]] || {
    printf 'CodeQL did not extract these files, so the scan did not check them.\n%s\n' "${skipped}" >&2
    return 1
  }
  count="$(jq '[.runs[].results[]?] | length' "${results}")" || return
  ((count == 0)) || {
    jq -r '.runs[].results[] | .locations[0].physicalLocation as $at
      | "\(.ruleId) \($at.artifactLocation.uri):\($at.region.startLine) \(.message.text)"' "${results}" >&2
    echo "CodeQL found ${count} results." >&2
    return 1
  }
  echo "CodeQL read every tracked TypeScript file and found no results."
}

lint_sql() {
  local listing file in_transaction=() concurrent=()
  listing="$(git ls-files -- '*.sql')" || return
  while IFS= read -r file; do
    if grep -qiE '^\s*create\s+(unique\s+)?index\s+concurrently\s' "${file}"; then concurrent+=("${file}"); else in_transaction+=("${file}"); fi
  done <<<"${listing}"
  node_modules/.bin/squawk --assume-in-transaction "${in_transaction[@]}" &&
    { ((${#concurrent[@]} == 0)) || node_modules/.bin/squawk "${concurrent[@]}"; }
}

tools="${XDG_CACHE_HOME:-${HOME}/.cache}/supabase-xquik-tools"

fetch_tools() {
  local platform name url sha256 member archive
  platform="$(uname -sm)" || return
  [[ "${platform}" == "Linux x86_64" ]] || {
    echo "The pinned gitleaks, lychee and vale releases are Linux x86_64 builds, so the checks run only on Linux x86_64." >&2
    return 1
  }
  mkdir -p "${tools}" "${workspace}/bin" || return
  while read -r name url sha256 member; do
    archive="${tools}/${sha256}.tar.gz"
    [[ -f "${archive}" ]] || {
      curl -fsSL --retry 3 -o "${archive}.$$" "${url}" && mv -f "${archive}.$$" "${archive}"
    } || return
    sha256sum --check --quiet <<<"${sha256}  ${archive}" || {
      echo "The cached ${name} release does not match its pinned sha256. Delete ${archive} and rerun." >&2
      return 1
    }
    mkdir "${workspace}/tools-${name}" &&
      tar -xzf "${archive}" -C "${workspace}/tools-${name}" "${member}" &&
      ln -s "${workspace}/tools-${name}/${member}" "${workspace}/bin/${name}" || return
  done <<'TOOLS'
gitleaks https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz 551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb gitleaks
lychee https://github.com/lycheeverse/lychee/releases/download/lychee-v0.24.2/lychee-x86_64-unknown-linux-musl.tar.gz 73657a111819a30c47c08352896796f23d64e4eb2b3ed39b6d32149241566fc5 lychee-x86_64-unknown-linux-musl/lychee
vale https://github.com/vale-cli/vale/releases/download/v3.24.0/vale_3.24.0_Linux_64-bit.tar.gz 867534ddb678abca7f214bc4706ead0922bd5252ffe8035fc227013f66c8b214 vale
TOOLS
}

scan_secrets() {
  [[ ! -e .gitleaksignore ]] || {
    echo "gitleaks reads .gitleaksignore whatever its flags say. Remove the file and fix each finding it hid." >&2
    return 1
  }
  printf '[extend]\nuseDefault = true\n' >"${workspace}/gitleaks.toml" && mkdir "${workspace}/gitleaks-ignore" &&
    "${workspace}/bin/gitleaks" git --config="${workspace}/gitleaks.toml" \
      --gitleaks-ignore-path="${workspace}/gitleaks-ignore" --ignore-gitleaks-allow --max-archive-depth=8 \
      --log-opts="--full-history --all --diff-merges=remerge" --no-banner --no-color --redact --verbose .
}

check_links() {
  [[ ! -e .lycheeignore ]] || {
    echo "lychee reads .lycheeignore whatever its flags say. Remove the file and fix each link it hid." >&2
    return 1
  }
  : >"${workspace}/lychee.toml" &&
    git ls-files --cached --others --exclude-standard -- '*.md' |
    "${workspace}/bin/lychee" --config="${workspace}/lychee.toml" --offline --no-progress --include-fragments=full \
      --include-verbatim --include-mail --files-from -
}

lint_prose() {
  local listing files=() status=0
  listing="$(git ls-files --cached --others --exclude-standard -- '*.md')" || return
  mapfile -t files <<<"${listing}"
  "${workspace}/bin/vale" --output=line "${files[@]}" >"${workspace}/vale.log" || status=$?
  [[ ! -s "${workspace}/vale.log" ]] || {
    cat "${workspace}/vale.log" >&2
    return 1
  }
  return "${status}"
}

lint_code_health() {
  local fallow=node_modules/.bin/fallow
  "${fallow}" health --no-cache --complexity --fail-on-issues --quiet &&
    "${fallow}" dupes --no-cache --quiet &&
    "${fallow}" dupes --no-cache --cross-language --quiet
}


lint_type_aware() {
  local source="${workspace}/oxlint-source" listing files=() files_json
  listing="$(git ls-files --cached --others --exclude-standard -- '*.ts')" || return
  mapfile -t files <<<"${listing}"
  files_json="$(jq -nR '[inputs]' <<<"${listing}")" || return
  mkdir "${source}" &&
    git ls-files -z --cached --others --exclude-standard | tar --null -T - -cf - | tar -xf - -C "${source}" || return
  (
    cd "${source}" || exit
    "${root}/${deno}" install --vendor --frozen --quiet || exit
    "${root}/${deno}" types >deno.d.ts || exit
    local found meta metas=()
    found="$(find vendor/jsr.io -name '*_meta.json')" || exit
    while IFS= read -r meta; do metas+=(--slurpfile "${meta}" "${meta}"); done <<<"${found}"
    jq -n --slurpfile config deno.json --slurpfile lock deno.lock --argjson files "${files_json}" "${metas[@]}" '
      $ARGS.named as $metas
      | [ $lock[0].specifiers | to_entries[] | select(.key | startswith("jsr:"))
          | (.key | capture("^jsr:(?<name>@[^/@]+/[^/@]+)@").name) as $name
          | { specifier: .key, root: "./vendor/jsr.io/\($name)/\(.value)/",
              exports: $metas["vendor/jsr.io/\($name)/\(.value)_meta.json"][0].exports } ] as $packages
      | [ $config[0].imports | to_entries[] | select(.value | startswith("jsr:")) ] as $aliases
      | [ $packages[] as $package
          | ([$package.specifier] + [$aliases[] | select(.value == $package.specifier) | .key])[] as $prefix
          | $package.exports | to_entries[]
          | { key: ($prefix + (.key | ltrimstr("."))), value: [$package.root + (.value | ltrimstr("./"))] } ] as $paths
      | [ $config[0].imports | to_entries[] | select(.value | startswith("./"))
          | { key: (.key + "*"), value: [.value + "*"] } ] as $locals
      | { compilerOptions: ($config[0].compilerOptions + { target: "esnext", module: "preserve",
            moduleResolution: "bundler", lib: ["esnext"], noEmit: true, allowImportingTsExtensions: true,
            paths: ($paths + $locals | from_entries) }),
          files: (["deno.d.ts"] + $files) }' >tsconfig.json || exit
    OXLINT_TSGOLINT_PATH="${root}/node_modules/.bin/tsgolint" "${root}/node_modules/.bin/oxlint" \
      --type-aware --type-check --format=unix "${files[@]}"
  )
}

run_check "bans" "Suppression and exclusion ban" \
  "Remove each suppression or exclusion listed above and fix what it hid." no_banned_patterns
run_check "deno.json keys" "Exclusion keys in deno.json" "Remove the keys listed above." no_config_exclusions
run_check "" "Fetch the pinned gitleaks, lychee and vale releases" \
  "Check network access to github.com, then rerun." fetch_tools
run_check "gitleaks" "Secret scan of the full git history with gitleaks" \
  "Remove each secret listed above from history, rotate it, then rerun." scan_secrets
run_check "lychee" "Link check of every tracked Markdown file with lychee" \
  "Fix each broken link or fragment listed above." check_links
run_check "vale" "Prose lint of every tracked Markdown file with vale" \
  "Rewrite each sentence listed above." lint_prose
run_check "shellcheck" "Shell lint with every optional shellcheck check" "Fix the shellcheck findings above." lint_shell
run_check "REUSE" "Licensing with REUSE lint" \
  "Give each file listed above a license and copyright in REUSE.toml or an SPDX header." \
  uv tool run --from "reuse==${reuse_version}" reuse lint
run_check "format" "Format check" "Run ${deno} fmt, then rerun." "${deno}" fmt --check
run_check "lint" "Lint" "Fix the lint findings above." "${deno}" lint
run_check "oxlint" "Type-aware lint with oxlint and tsgolint" \
  "Fix the oxlint findings and type errors above." lint_type_aware
run_check "fallow" "Complexity and duplication with fallow" \
  "Split each function or merge each clone listed above." lint_code_health
run_check "types" "Type check" "Fix the type errors above." "${deno}" check
run_check "100% typed, awaited promises" "Type coverage and floating promises" \
  "Give each value listed above a type without any, and await each promise listed above." type_coverage
run_check "squawk" "SQL lint" "Fix the squawk findings above." lint_sql
run_check "audit" "Dependency audit of deno.lock and bun.lock" \
  "Upgrade each package named above, then rerun." audit_dependencies
run_check "tests" "Tests with 100% line, branch and function coverage" \
  "Fix the failing tests, run the ignored ones, or test the lines, branches and functions listed above." run_tests
tests_passed="$(sed -nE 's/^ok \| ([0-9]+) passed.*/\1/p' "${workspace}/tests.log" | tail -n 1)"
run_check "CodeQL" "Static analysis with the CodeQL security-extended queries" \
  "Fix the CodeQL findings above, then rerun." run_codeql

mutation_minimum="81.34"

mutation_tests() {
  local listing files=()
  listing="$(git ls-files --cached --others --exclude-standard -- '*.ts' 'supabase/migrations/*.sql' \
    ':(exclude)*_test.ts' ':(exclude)*.d.ts')" || return
  mapfile -t files <<<"${listing}"
  "${deno}" run --allow-read --allow-write --allow-run --allow-env scripts/mutate.ts "${mutation_minimum}" "${files[@]}"
}

run_check "mutation score ${mutation_minimum}%" "Mutation tests of every TypeScript source and SQL function" \
  "Add a test that fails on each surviving mutant listed above." mutation_tests

current_check="Final tree check"
if [[ -n "${status_commit}" ]]; then
  head_commit="$(git rev-parse HEAD)"
  tree_changes="$(git status --porcelain)"
  [[ "${head_commit}" == "${status_commit}" && -z "${tree_changes}" ]] || {
    echo "check-local: the tree changed during the checks. Commit or remove the changes, then rerun." >&2
    exit 1
  }
fi
printf -v joined '%s, ' "${passed[@]}"
echo "The checks were ${joined%, }."
summary="${#passed[@]} checks with ${tests_passed:+${tests_passed} }tests at 100% coverage."
echo "All local checks passed. They were ${summary}"
